<Window x:Class="ObeliskPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ObeliskPanel" Height="920" Width="1200" MinWidth="980" MinHeight="600"
        Icon="Assets/app.ico" Closing="Window_Closing" StateChanged="Window_StateChanged">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="58" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="WinButton" TargetType="Button">
      <Setter Property="Foreground" Value="#D5E2E8"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#26FFFFFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#40FFFFFF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WinCloseButton" TargetType="Button" BasedOn="{StaticResource WinButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#C42B1C"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#A32315"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HeaderButton" TargetType="Button">
      <Setter Property="Foreground" Value="#E6F1F4"/>
      <Setter Property="Background" Value="#14FFFFFF"/>
      <Setter Property="BorderBrush" Value="#26FFFFFF"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#2EFFFFFF"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#47FFFFFF"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="HeaderAccentButton" TargetType="Button">
      <Setter Property="Foreground" Value="#0F1F26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="#00D9CE" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#3DF0E6"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#00B5AC"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ModePill" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#B7C9D6"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="18,5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource ModeAccent}"/>
                <Setter Property="Foreground" Value="#0F1F26"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ServerTab" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#B7C9D6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Margin="0,0,4,0">
              <Border x:Name="b" Background="Transparent" CornerRadius="8,8,0,0" Padding="16,6,16,9">
                <ContentPresenter/>
              </Border>
              <Border x:Name="line" Height="3" VerticalAlignment="Bottom" CornerRadius="2" Margin="10,0" Background="Transparent"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#14FFFFFF"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="#24FFFFFF"/>
                <Setter TargetName="line" Property="Background" Value="{DynamicResource ModeAccent}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <SolidColorBrush x:Key="ModeAccent" Color="#5AB4FF"/>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Opacity" Value="0.7"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>

  <DockPanel x:Name="RootPanel">
    <Border x:Name="HeaderBar" DockPanel.Dock="Top" Padding="16,10,8,0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#0E1A20" Offset="0"/>
          <GradientStop Color="#1B313A" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <StackPanel>
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="Assets/logo.png" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
              <TextBlock Text="ObeliskPanel" FontSize="20" FontWeight="Bold" Foreground="White"/>
              <TextBlock x:Name="ModeTitle" Text="Survival Ascended" FontSize="12" FontWeight="SemiBold" Margin="1,-2,0,0"/>
            </StackPanel>
            <Border Background="#1FFFFFFF" CornerRadius="9" Padding="3" Margin="24,0,0,0" VerticalAlignment="Center"
                    WindowChrome.IsHitTestVisibleInChrome="True">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ModeAsa" GroupName="Mode" Content="ASA" Style="{StaticResource ModePill}"
                             Checked="Mode_Checked" ToolTip="ARK: Survival Ascended servers"/>
                <RadioButton x:Name="ModeAse" GroupName="Mode" Content="ASE" Style="{StaticResource ModePill}"
                             Checked="Mode_Checked" ToolTip="ARK: Survival Evolved servers"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,-4,0,0">
            <Button Content="&#xE921;" Click="Minimize_Click" Style="{StaticResource WinButton}" ToolTip="Minimize"/>
            <Button x:Name="MaxBtn" Content="&#xE922;" Click="Maximize_Click" Style="{StaticResource WinButton}" ToolTip="Maximize"/>
            <Button Content="&#xE8BB;" Click="Close_Click" Style="{StaticResource WinCloseButton}" ToolTip="Close"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                      WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Content="＋  New Server" Click="Add_Click" Style="{StaticResource HeaderAccentButton}"/>
            <Button Content="⧉  Duplicate" Click="Duplicate_Click" Style="{StaticResource HeaderButton}"/>
            <Button Content="🗑  Remove" Click="Remove_Click" Style="{StaticResource HeaderButton}"/>
            <Border Width="1" Background="#33FFFFFF" Margin="6,6,12,6"/>
            <Button Content="▶  Start all" Click="StartAll_Click" Style="{StaticResource HeaderButton}"/>
            <Button Content="■  Stop all" Click="StopAll_Click" Style="{StaticResource HeaderButton}"/>
            <Border Width="1" Background="#33FFFFFF" Margin="6,6,12,6"/>
            <Button x:Name="ThemeBtn" Click="ThemeBtn_Click" Style="{StaticResource HeaderButton}" Margin="0,0,6,0" MinWidth="40"/>
            <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" Click="Settings_Click" Style="{StaticResource HeaderButton}"
                    Margin="0" MinWidth="40" ToolTip="Settings – server folders, cluster, SteamCMD, API keys"/>
          </StackPanel>
          <Grid/>
        </DockPanel>
        <ListBox x:Name="ServerTabs" Margin="0,12,0,0" BorderThickness="0" Background="Transparent"
                 ItemContainerStyle="{StaticResource ServerTab}"
                 SelectionChanged="ServerTabs_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Text="{Binding Map}" FontSize="11" Opacity="0.7"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>
    <Border x:Name="ModeStripe" DockPanel.Dock="Top" Height="3"/>

    <DockPanel x:Name="ServerPanel" Margin="14,12,14,14" IsEnabled="False">
      <Border x:Name="StatusCard" DockPanel.Dock="Top" Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="StartBtn" Content="▶  Start" Click="Start_Click" MinWidth="100" Margin="0,0,6,0" Style="{DynamicResource AccentButtonStyle}"/>
              <Button x:Name="StopBtn" Content="■  Stop" Click="Stop_Click" MinWidth="90" Margin="0,0,6,0"/>
              <Button x:Name="KillBtn" Content="Kill" Click="Kill_Click" Margin="0,0,6,0"/>
              <Button x:Name="UpdateBtn" Content="⟳  Update" Click="Update_Click" Margin="0,0,6,0"/>
              <Button Content="Launch Command" Click="ShowArgs_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="StateBadge" CornerRadius="12" Padding="10,4" Margin="0,0,22,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="StateDot" Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="StateText" Text="Stopped" FontWeight="SemiBold"/>
                </StackPanel>
              </Border>
              <StackPanel Margin="0,0,26,0">
                <TextBlock Text="PLAYERS" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="PlayersText" Text="–" Style="{StaticResource Value}"/>
              </StackPanel>
              <StackPanel Margin="0,0,26,0">
                <TextBlock Text="PROCESS ID" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="PidText" Text="0" Style="{StaticResource Value}"/>
              </StackPanel>
              <StackPanel Margin="0,0,26,0">
                <TextBlock Text="MAP · PORT" Style="{StaticResource Caption}"/>
                <TextBlock x:Name="MapText" Text="–" Style="{StaticResource Value}"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="CONNECT" Style="{StaticResource Caption}"/>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="ConnectText" Text="–" Style="{StaticResource Value}" ToolTip="Public address players connect to"/>
                  <Button x:Name="CopyConnectBtn" Content="Copy" Click="CopyConnect_Click" Padding="8,1" MinWidth="0" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </DockPanel>
          <DockPanel Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Send" Click="RconSend_Click" Margin="6,0,0,0"/>
            <ComboBox x:Name="RconPreset" DockPanel.Dock="Right" Width="220" Margin="6,0,0,0"
                      SelectionChanged="RconPreset_SelectionChanged" ToolTip="Common RCON commands"/>
            <TextBlock DockPanel.Dock="Left" Text="RCON" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
            <TextBox x:Name="RconInput" KeyDown="RconInput_KeyDown" VerticalContentAlignment="Center"
                     ToolTip="Type a command and press Enter"/>
          </DockPanel>
        </StackPanel>
      </Border>

      <Border x:Name="LockBanner" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,8"
              CornerRadius="6" BorderThickness="1" BorderBrush="#66FFB34D" Background="#22FFB34D">
        <TextBlock x:Name="LockText" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#FFB34D"
                   Text="🔒  The server is running – settings and mods are read-only. Stop the server to change them."/>
      </Border>
      <TabControl x:Name="MainTabs" Margin="0,12,0,0">
        <TabItem Header="Server Settings">
          <DockPanel Margin="0,8,0,0">
            <ListBox x:Name="NavList" Width="210" DockPanel.Dock="Left" BorderThickness="0"
                     SelectionChanged="NavList_SelectionChanged"/>
            <Border x:Name="PageCard" Style="{StaticResource Card}" Padding="6" Margin="10,0,0,0">
              <ContentControl x:Name="PageHost"/>
            </Border>
          </DockPanel>
        </TabItem>
        <TabItem Header="Output">
          <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                   Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" VerticalContentAlignment="Stretch"/>
        </TabItem>
        <TabItem Header="Mods">
          <ContentControl x:Name="ModsHost" Margin="0,8,0,0"/>
        </TabItem>
        <TabItem Header="Backups">
          <ContentControl x:Name="BackupsHost" Margin="0,8,0,0"/>
        </TabItem>
        <TabItem Header="Restart Schedule">
          <ContentControl x:Name="RestartHost" Margin="0,8,0,0"/>
        </TabItem>
        <TabItem Header="Discord">
          <ContentControl x:Name="DiscordHost" Margin="0,8,0,0"/>
        </TabItem>
        <TabItem Header="Scheduled Messages">
          <ContentControl x:Name="MessagesHost" Margin="0,8,0,0"/>
        </TabItem>
        <TabItem Header="Server API">
          <ContentControl x:Name="ApiHost" Margin="0,8,0,0"/>
        </TabItem>
      </TabControl>
    </DockPanel>
  </DockPanel>
</Window>
